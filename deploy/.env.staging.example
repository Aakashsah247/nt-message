# NT Message staging environment
# Copy to .env.staging, fill real values, chmod 600, and never commit it.

COMPOSE_PROJECT_NAME=nt-message-staging
NODE_ENV=production

# Public staging URL. HTTPS is required to fully test browser push notifications.
STAGING_ORIGIN=https://ntmessage-test.aakashsah247.com.np
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_HTTP_PORT=8080

API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=//ntmessage-test.aakashsah247.com.np

# PostgreSQL runs only on the private Compose network.
# PostgreSQL
POSTGRES_DB=nt_message
POSTGRES_USER=nt_message_app
POSTGRES_PASSWORD=replace_with_secure_password
DATABASE_URL=postgresql://nt_message_app:replace_with_secure_password@localhost:5432/nt_message?schema=public


# Real SMTP relay/provider for staging test users.
SMTP_HOST=REPLACE_WITH_APPROVED_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM="NT Message Staging <no-reply@ntc.net.np>"
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Authentication
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_refresh_secret

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

AUTH_COOKIE_NAME=nt_message_refresh

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Shared OTP security controls
# Use a long random secret. OTP values are stored only as HMAC hashes.
OTP_HASH_SECRET=replace_with_long_random_otp_hash_secret
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Account activation token
ACTIVATION_TOKEN_SECRET=replace_with_long_random_secret
ACTIVATION_TOKEN_TTL_SECONDS=600

# Secure account invitation link
ACTIVATION_INVITATION_TTL_HOURS=72

# Storage inside API container. Host paths below provide persistence across container replacement.
ATTACHMENT_STORAGE_ROOT=/var/lib/nt-message/attachments
ATTACHMENT_UPLOAD_TEMP_DIR=/var/lib/nt-message/attachments/.incoming
PROFILE_PHOcleaTO_STORAGE_DIR=/var/lib/nt-message/profile-photos
GROUP_PHOTO_STORAGE_DIR=/var/lib/nt-message/group-photos
ATTACHMENT_STORAGE_HOST_PATH=./deploy-data/attachments
PROFILE_PHOTO_STORAGE_HOST_PATH=./deploy-data/profile-photos
GROUP_PHOTO_STORAGE_HOST_PATH=./deploy-data/group-photos

MESSAGE_PRIVATE_ATTACHMENT_RETENTION_DAYS=90
MESSAGE_PERSONAL_GROUP_ATTACHMENT_RETENTION_DAYS=30
MESSAGE_OFFICIAL_GROUP_ATTACHMENT_RETENTION_DAYS=30
ANNOUNCEMENT_ATTACHMENT_RETENTION_DAYS=90

# Production-mode staging intentionally fails closed unless ClamAV is available.
ATTACHMENT_SCAN_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=180000

# Generate a fresh staging VAPID pair. Never reuse the pair that was previously present in .env.example.
WEB_PUSH_VAPID_PUBLIC_KEY=REPLACE_WITH_NEW_STAGING_PUBLIC_KEY
WEB_PUSH_VAPID_PRIVATE_KEY=REPLACE_WITH_NEW_STAGING_PRIVATE_KEY
WEB_PUSH_VAPID_SUBJECT=mailto:REPLACE_WITH_OPERATIONS_CONTACT@ntc.net.np
WEB_PUSH_TTL_SECONDS=300

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=nt-message-staging

DATABASE_URL=postgresql://YOUR_SUPABASE_SESSION_POOLER_CONNECTION