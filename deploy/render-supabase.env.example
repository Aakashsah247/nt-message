# Temporary zero-cash field-test deployment only.
# Do not commit real values. Never reuse these secrets for Nepal Telecom production.

NODE_ENV=production
DEPLOYMENT_PROFILE=temporary_external_staging
ALLOW_UNSCANNED_STAGING_ATTACHMENTS=true
API_HOST=0.0.0.0
# Render supplies PORT automatically; API_PORT can remain unset.
WEB_ORIGIN=https://YOUR_RENDER_WEB_SERVICE.onrender.com

# Supabase PostgreSQL: use the Session pooler connection string (port 5432),
# not the IPv6-only direct connection, because Render is IPv4-only.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres

# Temporary staging object storage. Bucket must be PRIVATE.
ATTACHMENT_STORAGE_DRIVER=supabase
ATTACHMENT_STORAGE_MAX_OBJECT_BYTES=52428800
ATTACHMENT_UPLOAD_TEMP_DIR=/tmp/nt-message-uploads
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_BACKEND_ONLY_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=nt-message-staging
SUPABASE_SIGNED_URL_TTL_SECONDS=300

# Render Free cannot run the ClamAV sidecar used by NTC production.
# This explicit exception is allowed only with DEPLOYMENT_PROFILE above.
ATTACHMENT_SCAN_MODE=disabled

MESSAGE_PRIVATE_ATTACHMENT_RETENTION_DAYS=90
MESSAGE_PERSONAL_GROUP_ATTACHMENT_RETENTION_DAYS=30
MESSAGE_OFFICIAL_GROUP_ATTACHMENT_RETENTION_DAYS=30
ANNOUNCEMENT_ATTACHMENT_RETENTION_DAYS=90

JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_32_BYTE_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_BYTE_VALUE
OTP_HASH_SECRET=REPLACE_WITH_RANDOM_32_BYTE_VALUE
ACTIVATION_TOKEN_SECRET=REPLACE_WITH_RANDOM_32_BYTE_VALUE
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_NAME=nt_message_render_staging_refresh
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
ACTIVATION_TOKEN_TTL_SECONDS=600
ACTIVATION_INVITATION_TTL_HOURS=72

SUPER_ADMIN_NAME="REPLACE_WITH_TEST_ADMIN_NAME"
SUPER_ADMIN_EMAIL=REPLACE_WITH_TEST_EMAIL
SUPER_ADMIN_PHONE=98XXXXXXXX
SUPER_ADMIN_INITIAL_PASSWORD=REPLACE_WITH_AT_LEAST_16_CHARACTERS
INITIAL_ADMIN_USERNAME=admin

# Render Free blocks SMTP ports 25/465/587. If email testing is needed,
# use an approved temporary provider that supports an allowed port such as 2525.
SMTP_HOST=REPLACE_WITH_TEST_SMTP_HOST
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM="NT Message Test <REPLACE_WITH_TEST_FROM_EMAIL>"
SMTP_USER=REPLACE_WITH_TEST_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_TEST_SMTP_PASSWORD
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

WEB_PUSH_VAPID_PUBLIC_KEY=REPLACE_WITH_NEW_STAGING_PUBLIC_KEY
WEB_PUSH_VAPID_PRIVATE_KEY=REPLACE_WITH_NEW_STAGING_PRIVATE_KEY
WEB_PUSH_VAPID_SUBJECT=mailto:REPLACE_WITH_YOUR_EMAIL
WEB_PUSH_TTL_SECONDS=300
