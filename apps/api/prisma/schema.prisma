model MessageAttachment {
  id String @id @default(uuid()) @db.Uuid

  messageId String @map("message_id") @db.Uuid

  storageKey       String             @map("storage_key") @db.VarChar(500)
  originalFileName String             @map("original_file_name") @db.VarChar(255)
  mimeType         String             @map("mime_type") @db.VarChar(120)
  fileSizeBytes    Int                @map("file_size_bytes")
  contentType      MessageContentType @map("content_type")
  scanStatus       String             @default("PENDING") @map("scan_status") @db.VarChar(40)

  // Retention belongs to the logical message reference, not the shared physical file.
  // Forwarding therefore gets a fresh expiry while the same storageKey can be reused.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  expiredAt DateTime? @map("expired_at") @db.Timestamptz(3)
  purgedAt  DateTime? @map("purged_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "message_attachments_message_idx")
  @@index([originalFileName(ops: raw("gin_trgm_ops"))], type: Gin, map: "message_attachments_original_file_name_trgm_idx")
  @@index([storageKey], map: "message_attachments_storage_key_idx")
  @@index([expiresAt, expiredAt], map: "message_attachments_expiry_idx")
  @@index([purgedAt, expiresAt], map: "message_attachments_purge_idx")
  @@index([contentType], map: "message_attachments_content_type_idx")
  @@map("message_attachments")
}

