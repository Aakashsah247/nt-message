  recipient Account @relation("MessageRequestsReceived", fields: [recipientAccountId], references: [id], onDelete: Restrict)
  blockedBy Account? @relation("MessageRequestsBlockedBy", fields: [blockedByAccountId], references: [id], onDelete: Restrict)
