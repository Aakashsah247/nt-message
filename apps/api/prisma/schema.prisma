  hierarchyOverride   Boolean                 @default(false) @map("hierarchy_override")
  conflictOverride    Boolean                 @default(false) @map("conflict_override")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee    Account            @relation("DutyScheduleSeriesEmployee", fields: [employeeAccountId], references: [id], onDelete: Restrict)
  shift       DutyShiftTemplate? @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  supervisor  Account            @relation("DutyScheduleSeriesSupervisor", fields: [supervisorAccountId], references: [id], onDelete: Restrict)
  createdBy   Account            @relation("DutyScheduleSeriesCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
