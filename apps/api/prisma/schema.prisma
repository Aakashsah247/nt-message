generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  SUPER_ADMIN
  SENIOR_MANAGEMENT
  TEAM_MANAGER
  EMPLOYEE
}

enum ManagementPositionType {
  SENIOR_MANAGEMENT
  TEAM_MANAGER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  RESIGNED
  RETIRED
  TERMINATED
  TRANSFERRED
}

enum EmployeeLifecycleActionType {
  SUSPENDED
  REACTIVATED
  RESIGNED
  RETIRED
  TERMINATED
  ARCHIVED
  UNARCHIVED
  TRANSFERRED
  PROMOTED
  DEMOTED
  REHIRED
}

enum OtpPurpose {
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
}

enum AccountRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVATION_PENDING
  ACTIVATED
}

enum AccountRequestActionType {
  CREATED
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
  ACTIVATION_STARTED
  ACTIVATED
}

enum ActivityEventType {
  LOGIN
  LOGOUT
  PAGE_VIEW
  BUTTON_CLICK
  ACTIVE_HEARTBEAT
  IDLE_STARTED
  IDLE_HEARTBEAT
  ACTIVE_RESUMED
  EMERGENCY_ALERT_SENT
  SESSION_POLICY_LOGOUT
}

enum ConversationType {
  PRIVATE
  GROUP
  ANNOUNCEMENT
}

enum GroupKind {
  PERSONAL
  OFFICIAL
}

enum ConversationParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum OfficialGroupScopeType {
  ORGANIZATION
  DIVISION
  DEPARTMENT
}

enum OfficialGroupAuditAction {
  CREATED
  DETAILS_UPDATED
  MEMBERSHIP_SYNCED
  RECONCILED
}

enum MessageContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
  SYSTEM
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum MessageRequestReason {
  PROTECTED_RECIPIENT
  CROSS_DEPARTMENT
  CROSS_DIVISION
}

enum MessagingNotificationType {
  MESSAGE
  REPLY
  REACTION
  FILE
  IMAGE
  VIDEO
  AUDIO
  VOICE_NOTE
  GROUP_EVENT
  MENTION
}

enum EmergencyAlertRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NO_PHONE
}

model Division {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  departments               Department[]
  employees                 Employee[]
  accountRequests           AccountRequest[]
  managementPositions       ManagementPosition[]
  officialGroupConversations Conversation[] @relation("OfficialGroupDivision")

  @@index([isActive], map: "divisions_is_active_idx")
  @@map("divisions")
}

model Department {
  id         String   @id @default(uuid()) @db.Uuid
  divisionId String   @map("division_id") @db.Uuid
  code       String   @db.VarChar(50)
  name       String   @db.VarChar(120)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division                   Division             @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  employees                  Employee[]
  accountRequests            AccountRequest[]
  managementPositions        ManagementPosition[]
  officialGroupConversations Conversation[]         @relation("OfficialGroupDepartment")

  @@unique([divisionId, code], map: "departments_division_id_code_key")
  @@unique([divisionId, name], map: "departments_division_id_name_key")
  @@index([divisionId], map: "departments_division_id_idx")
  @@index([isActive], map: "departments_is_active_idx")
  @@map("departments")
}

model Employee {
  id            String @id @default(uuid()) @db.Uuid
  empId         String @unique @map("emp_id") @db.VarChar(50)
  empName       String @map("emp_name") @db.VarChar(150)
  phoneNumber   String @unique(map: "employees_phone_number_key") @map("phone_number") @db.VarChar(20)
  officialEmail String @unique @map("official_email") @db.VarChar(255)

  divisionId   String? @map("division_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid

  department  String? @db.VarChar(120)
  designation String? @db.VarChar(120)

  status           EmployeeStatus   @default(ACTIVE)
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")

  employmentEndedAt   DateTime? @map("employment_ended_at") @db.Timestamptz(3)
  employmentEndReason String?   @map("employment_end_reason") @db.VarChar(500)
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)

  isActivated     Boolean @default(false) @map("is_activated")
  profilePhotoKey String? @map("profile_photo_key") @db.VarChar(500)
  profileBio      String? @map("profile_bio") @db.VarChar(160)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division       Division?   @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  departmentUnit Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  account               Account?
  otpVerifications      OtpVerification[]
  accountRequests       AccountRequest[]
  lifecycleActions      EmployeeLifecycleAction[]
  managementAssignments ManagementAssignment[]

  @@index([empName], map: "employees_emp_name_idx")
  @@index([department], map: "employees_department_idx")
  @@index([divisionId], map: "employees_division_id_idx")
  @@index([departmentId], map: "employees_department_id_idx")
  @@index([status], map: "employees_status_idx")
  @@index([employmentStatus], map: "employees_employment_status_idx")
  @@index([archivedAt], map: "employees_archived_at_idx")
  @@map("employees")
}

model Account {
  id                  String      @id @default(uuid()) @db.Uuid
  employeeId          String?     @unique @map("employee_id") @db.Uuid
  username            String?     @unique @db.VarChar(255)
  role                AccountRole
  passwordHash        String      @map("password_hash") @db.VarChar(255)
  isEnabled           Boolean     @default(true) @map("is_enabled")
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?   @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt   DateTime    @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  profilePhotoKey     String?     @map("profile_photo_key") @db.VarChar(500)
  profileBio          String?     @map("profile_bio") @db.VarChar(160)
  showOnlineStatus    Boolean     @default(true) @map("show_online_status")
  showReadReceipts    Boolean     @default(true) @map("show_read_receipts")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee                      Employee?                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sessions                      AuthSession[]
  submittedAccountRequests      AccountRequest[]          @relation("AccountRequestsRequestedBy")
  reviewedAccountRequests       AccountRequest[]          @relation("AccountRequestsReviewedBy")
  accountRequestActions         AccountRequestAction[]
  employeeLifecycleActions      EmployeeLifecycleAction[] @relation("EmployeeLifecycleActionsByActor")
  assignedManagementAssignments ManagementAssignment[]    @relation("ManagementAssignmentsAssignedBy")
  endedManagementAssignments    ManagementAssignment[]    @relation("ManagementAssignmentsEndedBy")
  createdConversations           Conversation[]            @relation("ConversationsCreatedBy")
  conversationParticipants      ConversationParticipant[]
  sentMessages                  Message[]                 @relation("MessagesSentBy")
  deletedMessages               Message[]                 @relation("MessagesDeletedBy")
  messageReceipts               MessageReceipt[]
  hiddenMessages                MessageHiddenForAccount[]
  messageReactions              MessageReaction[]
  messageStars                  MessageStar[]
  pinnedMessages                MessagePin[]              @relation("MessagePinsPinnedBy")
  unpinnedMessages              MessagePin[]              @relation("MessagePinsUnpinnedBy")
  sentMessageRequests           MessageRequest[]           @relation("MessageRequestsSent")
  receivedMessageRequests       MessageRequest[]           @relation("MessageRequestsReceived")
  blockedMessageRequests        MessageRequest[]           @relation("MessageRequestsBlockedBy")
  officialGroupAuditActions    OfficialGroupAuditLog[]      @relation("OfficialGroupAuditActor")
  receivedNotifications        MessagingNotification[]      @relation("MessagingNotificationsRecipient")
  actedNotifications           MessagingNotification[]      @relation("MessagingNotificationsActor")
  blocksCreated                MessagingAccountBlock[]      @relation("MessagingAccountBlocksCreated")
  blocksReceived               MessagingAccountBlock[]      @relation("MessagingAccountBlocksReceived")
  createdGroupInvitationLinks  GroupInvitationLink[]        @relation("GroupInvitationLinksCreatedBy")
  revokedGroupInvitationLinks  GroupInvitationLink[]        @relation("GroupInvitationLinksRevokedBy")
  activityEvents               ActivityEvent[]
  dailyActivitySummaries       DailyActivitySummary[]
  superAdminProfile            SuperAdminProfile?           @relation("SuperAdminProfileAccount")
  emergencyAlertsSent          EmergencyAlert[]             @relation("EmergencyAlertSender")
  emergencyAlertRecipients     EmergencyAlertRecipient[]    @relation("EmergencyAlertRecipientAccount")

  @@index([role], map: "accounts_role_idx")
  @@index([isEnabled], map: "accounts_is_enabled_idx")
  @@index([profilePhotoKey], map: "accounts_profile_photo_key_idx")
  @@map("accounts")
}

model ManagementPosition {
  id String @id @default(uuid()) @db.Uuid

  positionType ManagementPositionType @map("position_type")

  divisionId   String  @map("division_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid

  reservedByAccountRequestId String? @unique @map("reserved_by_account_request_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division   Division    @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  reservedByAccountRequest AccountRequest? @relation("ManagementPositionReservation", fields: [reservedByAccountRequestId], references: [id], onDelete: Restrict)

  assignments     ManagementAssignment[]
  accountRequests AccountRequest[]       @relation("AccountRequestManagementPosition")

  @@index([positionType], map: "management_positions_type_idx")
  @@index([divisionId], map: "management_positions_division_idx")
  @@index([departmentId], map: "management_positions_department_idx")
  @@index([isActive], map: "management_positions_is_active_idx")
  @@map("management_positions")
}

model ManagementAssignment {
  id String @id @default(uuid()) @db.Uuid

  positionId String @map("position_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  assignedByAccountId String  @map("assigned_by_account_id") @db.Uuid
  endedByAccountId    String? @map("ended_by_account_id") @db.Uuid

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  assignmentReason String? @map("assignment_reason") @db.VarChar(500)
  endReason        String? @map("end_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  position ManagementPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  assignedBy Account  @relation("ManagementAssignmentsAssignedBy", fields: [assignedByAccountId], references: [id], onDelete: Restrict)
  endedBy    Account? @relation("ManagementAssignmentsEndedBy", fields: [endedByAccountId], references: [id], onDelete: Restrict)

  @@index([positionId, endedAt], map: "management_assignments_position_ended_idx")
  @@index([employeeId, endedAt], map: "management_assignments_employee_ended_idx")
  @@index([assignedByAccountId], map: "management_assignments_assigned_by_idx")
  @@index([endedByAccountId], map: "management_assignments_ended_by_idx")
  @@index([startedAt], map: "management_assignments_started_at_idx")
  @@map("management_assignments")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activityEvents ActivityEvent[]

  @@index([accountId, revokedAt], map: "auth_sessions_account_revoked_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model OtpVerification {
  id           String     @id @default(uuid()) @db.Uuid
  employeeId   String     @map("employee_id") @db.Uuid
  purpose      OtpPurpose
  otpHash      String     @map("otp_hash") @db.VarChar(255)
  attemptCount Int        @default(0) @map("attempt_count")
  maxAttempts  Int        @default(5) @map("max_attempts")
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, purpose, createdAt], map: "otp_employee_purpose_created_idx")
  @@index([expiresAt], map: "otp_expires_at_idx")
  @@map("otp_verifications")
}

model AccountRequest {
  id String @id @default(uuid()) @db.Uuid

  empId         String  @map("emp_id") @db.VarChar(50)
  empName       String  @map("emp_name") @db.VarChar(150)
  phoneNumber   String  @map("phone_number") @db.VarChar(20)
  officialEmail String  @map("official_email") @db.VarChar(255)
  designation   String? @db.VarChar(120)

  requestedRole AccountRole @map("requested_role")

  divisionId   String? @map("division_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  employeeId   String? @map("employee_id") @db.Uuid

  managementPositionId String? @map("management_position_id") @db.Uuid

  requestedByAccountId String  @map("requested_by_account_id") @db.Uuid
  reviewedByAccountId  String? @map("reviewed_by_account_id") @db.Uuid

  previousRequestId String? @map("previous_request_id") @db.Uuid
  revisionNumber    Int     @default(1) @map("revision_number")

  status AccountRequestStatus @default(PENDING_APPROVAL)

  rejectionReason String? @map("rejection_reason") @db.VarChar(500)

  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  division   Division?   @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  managementPosition ManagementPosition? @relation("AccountRequestManagementPosition", fields: [managementPositionId], references: [id], onDelete: Restrict)

  reservedManagementPosition ManagementPosition? @relation("ManagementPositionReservation")

  requestedBy Account  @relation("AccountRequestsRequestedBy", fields: [requestedByAccountId], references: [id], onDelete: Restrict)
  reviewedBy  Account? @relation("AccountRequestsReviewedBy", fields: [reviewedByAccountId], references: [id], onDelete: Restrict)

  previousRequest AccountRequest?  @relation("AccountRequestRevisions", fields: [previousRequestId], references: [id], onDelete: Restrict)
  revisions       AccountRequest[] @relation("AccountRequestRevisions")

  actions AccountRequestAction[]

  @@index([status, createdAt], map: "account_requests_status_created_idx")
  @@index([requestedByAccountId, status], map: "account_requests_requester_status_idx")
  @@index([reviewedByAccountId], map: "account_requests_reviewer_idx")
  @@index([requestedRole], map: "account_requests_requested_role_idx")
  @@index([empId], map: "account_requests_emp_id_idx")
  @@index([officialEmail], map: "account_requests_official_email_idx")
  @@index([phoneNumber], map: "account_requests_phone_number_idx")
  @@index([divisionId, departmentId], map: "account_requests_org_scope_idx")
  @@index([employeeId], map: "account_requests_employee_idx")
  @@index([managementPositionId], map: "account_requests_management_position_idx")
  @@index([previousRequestId], map: "account_requests_previous_request_idx")
  @@map("account_requests")
}

model AccountRequestAction {
  id String @id @default(uuid()) @db.Uuid

  accountRequestId String  @map("account_request_id") @db.Uuid
  actorAccountId   String? @map("actor_account_id") @db.Uuid

  action AccountRequestActionType

  reason    String? @db.VarChar(500)
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(500)
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  accountRequest AccountRequest @relation(fields: [accountRequestId], references: [id], onDelete: Cascade)
  actor          Account?       @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([accountRequestId, createdAt], map: "account_request_actions_request_created_idx")
  @@index([actorAccountId, createdAt], map: "account_request_actions_actor_created_idx")
  @@index([action], map: "account_request_actions_action_idx")
  @@map("account_request_actions")
}

model EmployeeLifecycleAction {
  id String @id @default(uuid()) @db.Uuid

  employeeId     String @map("employee_id") @db.Uuid
  actorAccountId String @map("actor_account_id") @db.Uuid

  action EmployeeLifecycleActionType

  previousEmployeeStatus EmployeeStatus? @map("previous_employee_status")
  newEmployeeStatus      EmployeeStatus? @map("new_employee_status")

  previousEmploymentStatus EmploymentStatus? @map("previous_employment_status")
  newEmploymentStatus      EmploymentStatus? @map("new_employment_status")

  reason String? @db.VarChar(500)

  effectiveAt DateTime? @map("effective_at") @db.Timestamptz(3)

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(500)

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  actor    Account  @relation("EmployeeLifecycleActionsByActor", fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([employeeId, createdAt], map: "employee_lifecycle_actions_employee_created_idx")
  @@index([actorAccountId, createdAt], map: "employee_lifecycle_actions_actor_created_idx")
  @@index([action], map: "employee_lifecycle_actions_action_idx")
  @@map("employee_lifecycle_actions")
}

model Conversation {
  id String @id @default(uuid()) @db.Uuid

  type ConversationType @default(PRIVATE)

  title                 String?                 @db.VarChar(150)
  description           String?                 @db.VarChar(500)
  groupPhotoKey         String?                 @map("group_photo_key") @db.VarChar(500)
  groupKind             GroupKind?              @map("group_kind")
  officialScopeType     OfficialGroupScopeType? @map("official_scope_type")
  officialDivisionId   String?                 @map("official_division_id") @db.Uuid
  officialDepartmentId String?                 @map("official_department_id") @db.Uuid
  privateParticipantKey String?                @unique(map: "conversations_private_participant_key_key") @map("private_participant_key") @db.VarChar(73)

  createdByAccountId String @map("created_by_account_id") @db.Uuid

  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy          Account                   @relation("ConversationsCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  officialDivision   Division?                  @relation("OfficialGroupDivision", fields: [officialDivisionId], references: [id], onDelete: Restrict)
  officialDepartment Department?                @relation("OfficialGroupDepartment", fields: [officialDepartmentId], references: [id], onDelete: Restrict)
  participants       ConversationParticipant[]
  messages           Message[]
  messageRequest     MessageRequest?
  officialAuditLogs  OfficialGroupAuditLog[]
  notifications      MessagingNotification[]
  messagePins        MessagePin[]
  invitationLinks    GroupInvitationLink[]

  @@index([type, lastMessageAt], map: "conversations_type_last_message_idx")
  @@index([groupKind, updatedAt], map: "conversations_group_kind_idx")
  @@index([groupPhotoKey], map: "conversations_group_photo_key_idx")
  @@index([officialScopeType, officialDivisionId, officialDepartmentId], map: "conversations_official_scope_idx")
  @@index([createdByAccountId], map: "conversations_created_by_idx")
  @@index([lastMessageAt], map: "conversations_last_message_idx")
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String @map("conversation_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid

  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(3)

  role       ConversationParticipantRole @default(MEMBER)
  isMuted    Boolean @default(false) @map("is_muted")
  isArchived Boolean @default(false) @map("is_archived")
  isPinned   Boolean @default(false) @map("is_pinned")
  pinnedAt   DateTime? @map("pinned_at") @db.Timestamptz(3)
  mutedUntil DateTime? @map("muted_until") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  markedUnreadAt DateTime? @map("marked_unread_at") @db.Timestamptz(3)
  draftText String? @map("draft_text") @db.Text
  draftUpdatedAt DateTime? @map("draft_updated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([conversationId, accountId], map: "conversation_participants_pkey")
  @@index([accountId, leftAt, isArchived], map: "conversation_participants_account_active_idx")
  @@index([conversationId, leftAt], map: "conversation_participants_conversation_active_idx")
  @@index([conversationId, role, leftAt], map: "conversation_participants_conversation_role_idx")
  @@index([accountId, leftAt, isPinned, pinnedAt], map: "conversation_participants_account_pin_idx")
  @@index([accountId, isArchived, updatedAt], map: "conversation_participants_account_archive_idx")
  @@index([accountId, draftUpdatedAt], map: "conversation_participants_account_draft_idx")
  @@map("conversation_participants")
}




model GroupInvitationLink {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @map("conversation_id") @db.Uuid
  token          String @unique @db.VarChar(96)

  createdByAccountId String  @map("created_by_account_id") @db.Uuid
  revokedByAccountId String? @map("revoked_by_account_id") @db.Uuid

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
