generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  SUPER_ADMIN
  SENIOR_MANAGEMENT
  TEAM_MANAGER
  EMPLOYEE
}

enum ManagementPositionType {
  SENIOR_MANAGEMENT
  TEAM_MANAGER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  RESIGNED
  RETIRED
  TERMINATED
  TRANSFERRED
}

enum EmployeeLifecycleActionType {
  SUSPENDED
  REACTIVATED
  RESIGNED
  RETIRED
  TERMINATED
  ARCHIVED
  UNARCHIVED
  TRANSFERRED
  PROMOTED
  DEMOTED
  REHIRED
}

enum OtpPurpose {
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
}

enum AccountRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVATION_PENDING
  ACTIVATED
}

enum AccountRequestActionType {
  CREATED
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
  ACTIVATION_STARTED
  ACTIVATED
  ACTIVATION_EMAIL_QUEUED
  ACTIVATION_EMAIL_SENT
  ACTIVATION_EMAIL_FAILED
  ACTIVATION_EMAIL_RESENT
}

enum ActivationEmailDeliveryStatus {
  NOT_SENT
  PENDING
  SENT
  FAILED
}

enum ActivityEventType {
  LOGIN
  LOGOUT
  PAGE_VIEW
  BUTTON_CLICK
  ACTIVE_HEARTBEAT
  IDLE_STARTED
  IDLE_HEARTBEAT
  ACTIVE_RESUMED
  EMERGENCY_ALERT_SENT
  SESSION_POLICY_LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_COMPLETED
  CHAT_CLEARED
  CHAT_DELETED
  ANNOUNCEMENT_DRAFT_CREATED
  ANNOUNCEMENT_PUBLISHED
  ANNOUNCEMENT_EDITED
  ANNOUNCEMENT_WITHDRAWN
  ANNOUNCEMENT_ACKNOWLEDGED
}

enum ConversationType {
  PRIVATE
  GROUP
  ANNOUNCEMENT
}

enum GroupKind {
  PERSONAL
  OFFICIAL
}

enum ConversationParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum OfficialGroupScopeType {
  ORGANIZATION
  DIVISION
  DEPARTMENT
}

enum OfficialGroupAuditAction {
  CREATED
  DETAILS_UPDATED
  MEMBERSHIP_SYNCED
  RECONCILED
}

enum AnnouncementAudienceType {
  ORGANIZATION
  DIVISION
  DEPARTMENT
  OFFICIAL_GROUP
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
  EMERGENCY
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  EXPIRED
}

enum MessageContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
  SYSTEM
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum MessageRequestReason {
  PROTECTED_RECIPIENT
  CROSS_DEPARTMENT
  CROSS_DIVISION
}

enum MessagingNotificationType {
  MESSAGE
  REPLY
  REACTION
  FILE
  IMAGE
  VIDEO
  AUDIO
  VOICE_NOTE
  GROUP_EVENT
  MENTION
  ANNOUNCEMENT
  WORK_ITEM
  DUTY
}

enum EmergencyAlertRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NO_PHONE
}

enum WorkItemType {
  ROUTINE_TASK
  TROUBLE_TICKET
  MAINTENANCE
  NEW_CONNECTION
  UPDATE_SERVICES
  INSPECTION
  EMERGENCY_WORK
  ADMINISTRATIVE_TASK
}

enum WorkServiceType {
  DATA
  VOICE
  IPTV
  SIP
  OTHER
}

enum WorkContactType {
  MOBILE
  TELEPHONE
}

enum WorkPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum WorkItemStatus {
  ASSIGNED
  ACKNOWLEDGED
  IN_PROGRESS
  HELP_REQUESTED
  COMPLETED_PENDING_REVIEW
  CLOSED
  REOPENED
  BLOCKED
  CANCELLED
}

enum WorkAssignmentRole {
  PRIMARY
  SUPPORTING
}

enum WorkActivityAction {
  CREATED
  ASSIGNED
  TEAM_ASSIGNED
  SALES_MEMBER_ASSIGNED
  ACKNOWLEDGED
  STARTED
  STATUS_CHANGED
  REASSIGNED
  SUPPORT_ADDED
  SUPPORT_REMOVED
  HELP_REQUESTED
  HELP_ACCEPTED
  HELP_DECLINED
  COMPLETION_SUBMITTED
  INFORMATION_REQUESTED
  CLOSED
  REOPENED
  CANCELLED
  DETAILS_UPDATED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  RETENTION_HOLD_APPLIED
  RETENTION_HOLD_RELEASED
  DELETION_REVIEW_REQUESTED
  DELETION_REVIEW_CANCELLED
  DELEGATED
}

enum WorkCompletionResult {
  FULLY_RESOLVED
  TEMPORARY_SOLUTION
  UNABLE_TO_RESOLVE
}

enum WorkCompletionReviewStatus {
  PENDING_REVIEW
  INFORMATION_REQUESTED
  ACCEPTED
  REJECTED
}

enum WorkHelpReason {
  NEED_ANOTHER_EMPLOYEE
  TECHNICAL_GUIDANCE
  TOOLS_OR_MATERIALS
  SAFETY_CONCERN
  OTHER
}

enum WorkHelpRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum DutyRecurrenceType {
  ONE_TIME
  DATE_RANGE
  WEEKLY
}

enum DutyExceptionType {
  LEAVE
  HOLIDAY
}

enum WorkAvailabilityPreference {
  AVAILABLE
  BUSY
}

enum DepartmentWorkFunction {
  GENERAL
  FIELD_OPERATIONS
  SALES
  SUPPORT
}

enum DepartmentTeamActivityAction {
  TEAM_CREATED
  TEAM_RENAMED
  MEMBER_ADDED
  MEMBER_REMOVED
  ADMIN_CHANGED
  TEAM_ARCHIVED
  TEAM_DELETED
}

enum DutyAssignmentAuthority {
  STANDARD_HIERARCHY
  SUPER_ADMIN_OVERRIDE
}

enum DutyActivityAction {
  ASSIGNED
  OVERRIDE_ASSIGNED
  RESCHEDULED
  CANCELLED
  EXCEPTION_RECORDED
  AVAILABILITY_CHANGED
}

enum DutyCoverageRequirementAction {
  CREATED
  UPDATED
  RETIRED
}

model Division {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  departments                Department[]
  employees                  Employee[]
  accountRequests            AccountRequest[]
  managementPositions        ManagementPosition[]
  officialGroupConversations Conversation[]       @relation("OfficialGroupDivision")
  announcements              Announcement[]       @relation("AnnouncementDivision")
  workItems                  WorkItem[]
  dutyShiftTemplates         DutyShiftTemplate[]
  dutyScheduleSeries         DutyScheduleSeries[]
  dutyAssignments            DutyAssignment[]
  dutyExceptions             DutyException[]

  @@index([isActive], map: "divisions_is_active_idx")
  @@map("divisions")
}

model Department {
  id           String                 @id @default(uuid()) @db.Uuid
  divisionId   String                 @map("division_id") @db.Uuid
  code         String                 @db.VarChar(50)
  name         String                 @db.VarChar(120)
  workFunction DepartmentWorkFunction @default(GENERAL) @map("work_function")
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  division                   Division                  @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  employees                  Employee[]
  accountRequests            AccountRequest[]
  managementPositions        ManagementPosition[]
  officialGroupConversations Conversation[]            @relation("OfficialGroupDepartment")
  announcements              Announcement[]            @relation("AnnouncementDepartment")
  workItems                  WorkItem[]
  dutyShiftTemplates         DutyShiftTemplate[]
  dutyScheduleSeries         DutyScheduleSeries[]
  dutyAssignments            DutyAssignment[]
  dutyExceptions             DutyException[]
  dutyCoverageRequirements   DutyCoverageRequirement[]
  workHelpRequests           WorkHelpRequest[]
  employeeTeams              DepartmentTeam[]
  employeeTeamActivities     DepartmentTeamActivity[]

  @@unique([divisionId, code], map: "departments_division_id_code_key")
  @@unique([divisionId, name], map: "departments_division_id_name_key")
  @@index([divisionId], map: "departments_division_id_idx")
  @@index([divisionId, workFunction, isActive], map: "departments_division_function_active_idx")
  @@index([isActive], map: "departments_is_active_idx")
  @@map("departments")
}

model Employee {
  id            String @id @default(uuid()) @db.Uuid
  empId         String @unique @map("emp_id") @db.VarChar(50)
  empName       String @map("emp_name") @db.VarChar(150)
  phoneNumber   String @unique(map: "employees_phone_number_key") @map("phone_number") @db.VarChar(20)
  officialEmail String @unique @map("official_email") @db.VarChar(255)

  divisionId   String? @map("division_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid

  department  String? @db.VarChar(120)
  designation String? @db.VarChar(120)

  status           EmployeeStatus   @default(ACTIVE)
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")

  employmentEndedAt   DateTime? @map("employment_ended_at") @db.Timestamptz(3)
  employmentEndReason String?   @map("employment_end_reason") @db.VarChar(500)
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)

  isActivated     Boolean @default(false) @map("is_activated")
  profilePhotoKey String? @map("profile_photo_key") @db.VarChar(500)
  profileBio      String? @map("profile_bio") @db.VarChar(160)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division       Division?   @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  departmentUnit Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  account               Account?
  otpVerifications      OtpVerification[]
  accountRequests       AccountRequest[]
  activationInvitations ActivationInvitation[]
  lifecycleActions      EmployeeLifecycleAction[]
  managementAssignments ManagementAssignment[]
  teamMemberships       DepartmentTeamMember[]
  teamsAdministered     DepartmentTeam[]          @relation("DepartmentTeamAdmin")

  @@index([empName], map: "employees_emp_name_idx")
  @@index([department], map: "employees_department_idx")
  @@index([divisionId], map: "employees_division_id_idx")
  @@index([departmentId], map: "employees_department_id_idx")
  @@index([status], map: "employees_status_idx")
  @@index([employmentStatus], map: "employees_employment_status_idx")
  @@index([archivedAt], map: "employees_archived_at_idx")
  @@map("employees")
}

model Account {
  id                  String      @id @default(uuid()) @db.Uuid
  employeeId          String?     @unique @map("employee_id") @db.Uuid
  username            String?     @unique @db.VarChar(255)
  role                AccountRole
  passwordHash        String      @map("password_hash") @db.VarChar(255)
  isEnabled           Boolean     @default(true) @map("is_enabled")
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?   @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt   DateTime    @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  profilePhotoKey     String?     @map("profile_photo_key") @db.VarChar(500)
  profileBio          String?     @map("profile_bio") @db.VarChar(160)
  showOnlineStatus       Boolean     @default(true) @map("show_online_status")
  showReadReceipts       Boolean     @default(true) @map("show_read_receipts")
  requireMessageRequests Boolean     @default(true) @map("require_message_requests")
  interfaceLanguage     String      @default("en") @map("interface_language") @db.VarChar(8)
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee                        Employee?                         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sessions                        AuthSession[]
  submittedAccountRequests        AccountRequest[]                  @relation("AccountRequestsRequestedBy")
  reviewedAccountRequests         AccountRequest[]                  @relation("AccountRequestsReviewedBy")
  accountRequestActions           AccountRequestAction[]
  createdActivationInvitations    ActivationInvitation[]            @relation("ActivationInvitationsCreatedBy")
  employeeLifecycleActions        EmployeeLifecycleAction[]         @relation("EmployeeLifecycleActionsByActor")
  assignedManagementAssignments   ManagementAssignment[]            @relation("ManagementAssignmentsAssignedBy")
  endedManagementAssignments      ManagementAssignment[]            @relation("ManagementAssignmentsEndedBy")
  createdConversations            Conversation[]                    @relation("ConversationsCreatedBy")
  conversationParticipants        ConversationParticipant[]
  sentMessages                    Message[]                         @relation("MessagesSentBy")
  deletedMessages                 Message[]                         @relation("MessagesDeletedBy")
  messageReceipts                 MessageReceipt[]
  hiddenMessages                  MessageHiddenForAccount[]
  messageReactions                MessageReaction[]
  messageStars                    MessageStar[]
  pinnedMessages                  MessagePin[]                      @relation("MessagePinsPinnedBy")
  unpinnedMessages                MessagePin[]                      @relation("MessagePinsUnpinnedBy")
  sentMessageRequests             MessageRequest[]                  @relation("MessageRequestsSent")
  receivedMessageRequests         MessageRequest[]                  @relation("MessageRequestsReceived")
  blockedMessageRequests          MessageRequest[]                  @relation("MessageRequestsBlockedBy")
  officialGroupAuditActions       OfficialGroupAuditLog[]           @relation("OfficialGroupAuditActor")
  receivedNotifications           MessagingNotification[]           @relation("MessagingNotificationsRecipient")
  actedNotifications              MessagingNotification[]           @relation("MessagingNotificationsActor")
  blocksCreated                   MessagingAccountBlock[]           @relation("MessagingAccountBlocksCreated")
  blocksReceived                  MessagingAccountBlock[]           @relation("MessagingAccountBlocksReceived")
  createdGroupInvitationLinks     GroupInvitationLink[]             @relation("GroupInvitationLinksCreatedBy")
  revokedGroupInvitationLinks     GroupInvitationLink[]             @relation("GroupInvitationLinksRevokedBy")
  activityEvents                  ActivityEvent[]
  dailyActivitySummaries          DailyActivitySummary[]
  superAdminProfile               SuperAdminProfile?                @relation("SuperAdminProfileAccount")
  emergencyAlertsSent             EmergencyAlert[]                  @relation("EmergencyAlertSender")
  emergencyAlertRecipients        EmergencyAlertRecipient[]         @relation("EmergencyAlertRecipientAccount")
  passwordResetChallenges         PasswordResetChallenge[]
  announcementsCreated            Announcement[]                    @relation("AnnouncementsCreatedBy")
  announcementRevisions           AnnouncementRevision[]            @relation("AnnouncementRevisionEditor")
  announcementRecipients          AnnouncementRecipient[]
  announcementAcknowledgements    AnnouncementAcknowledgement[]
  workItemsCreated                WorkItem[]                        @relation("WorkItemsCreatedBy")
  workItemsManaged                WorkItem[]                        @relation("WorkItemsResponsibleManager")
  workItemsAsSalesMember          WorkItem[]                        @relation("WorkItemsSalesMember")
  workRetentionHolds              WorkItem[]                        @relation("WorkItemsRetentionHoldBy")
  workDeletionRequests            WorkItem[]                        @relation("WorkItemsDeletionRequestedBy")
  workAssignments                 WorkAssignment[]                  @relation("WorkAssignmentsAssignee")
  workAssignmentsCreated          WorkAssignment[]                  @relation("WorkAssignmentsAssignedBy")
  workActivities                  WorkActivity[]
  workCompletionReportsSubmitted  WorkCompletionReport[]            @relation("WorkCompletionReportsSubmittedBy")
  workCompletionReportsReviewed   WorkCompletionReport[]            @relation("WorkCompletionReportsReviewedBy")
  workHelpRequestsCreated         WorkHelpRequest[]                 @relation("WorkHelpRequestsCreatedBy")
  workHelpRequestsReceived        WorkHelpRequest[]                 @relation("WorkHelpRequestsRequestedHelper")
  workHelpRequestsResponded       WorkHelpRequest[]                 @relation("WorkHelpRequestsRespondedBy")
  workHelpRequestsCoordinated     WorkHelpRequest[]                 @relation("WorkHelpRequestsCoordinatedBy")
  dutyShiftTemplatesCreated       DutyShiftTemplate[]               @relation("DutyShiftTemplatesCreatedBy")
  dutyScheduleSeriesCreated       DutyScheduleSeries[]              @relation("DutyScheduleSeriesCreatedBy")
  dutyScheduleSeriesEmployee      DutyScheduleSeries[]              @relation("DutyScheduleSeriesEmployee")
  dutyScheduleSeriesSupervisor    DutyScheduleSeries[]              @relation("DutyScheduleSeriesSupervisor")
  dutyAssignmentsEmployee         DutyAssignment[]                  @relation("DutyAssignmentsEmployee")
  dutyAssignmentsSupervisor       DutyAssignment[]                  @relation("DutyAssignmentsSupervisor")
  dutyAssignmentsCreated          DutyAssignment[]                  @relation("DutyAssignmentsCreatedBy")
  dutyAssignmentsCancelled        DutyAssignment[]                  @relation("DutyAssignmentsCancelledBy")
  dutyExceptionsEmployee          DutyException[]                   @relation("DutyExceptionsEmployee")
  dutyExceptionsCreated           DutyException[]                   @relation("DutyExceptionsCreatedBy")
  workAvailability                EmployeeWorkAvailability?         @relation("EmployeeWorkAvailabilityAccount")
  dutyActivitiesEmployee          DutyActivity[]                    @relation("DutyActivitiesEmployee")
  dutyActivitiesActor             DutyActivity[]                    @relation("DutyActivitiesActor")
  dutyCoverageRequirementsCreated DutyCoverageRequirement[]         @relation("DutyCoverageRequirementsCreatedBy")
  dutyCoverageRequirementsUpdated DutyCoverageRequirement[]         @relation("DutyCoverageRequirementsUpdatedBy")
  dutyCoverageRequirementActions  DutyCoverageRequirementActivity[] @relation("DutyCoverageRequirementActivitiesActor")
  departmentTeamsCreated          DepartmentTeam[]                  @relation("DepartmentTeamsCreatedBy")
  departmentTeamsUpdated          DepartmentTeam[]                  @relation("DepartmentTeamsUpdatedBy")
  departmentTeamsArchived         DepartmentTeam[]                  @relation("DepartmentTeamsArchivedBy")
  departmentTeamMembersAdded      DepartmentTeamMember[]            @relation("DepartmentTeamMembersAddedBy")
  departmentTeamActivities        DepartmentTeamActivity[]          @relation("DepartmentTeamActivitiesActor")
  chatFolders                     ChatFolder[]
  chatFolderTargetItems           ChatFolderItem[]                  @relation("ChatFolderItemTargetAccount")

  @@index([role], map: "accounts_role_idx")
  @@index([isEnabled], map: "accounts_is_enabled_idx")
  @@index([profilePhotoKey], map: "accounts_profile_photo_key_idx")
  @@map("accounts")
}

model PasswordResetChallenge {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  otpHash      String @map("otp_hash") @db.VarChar(64)
  attemptCount Int    @default(0) @map("attempt_count")
  maxAttempts  Int    @default(5) @map("max_attempts")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)

  resetTokenHash      String?   @unique @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz(3)

  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt], map: "password_reset_challenges_account_created_idx")
  @@index([expiresAt], map: "password_reset_challenges_expires_at_idx")
  @@index([resetTokenExpiresAt], map: "password_reset_challenges_token_expires_idx")
  @@map("password_reset_challenges")
}

model ManagementPosition {
  id String @id @default(uuid()) @db.Uuid

  positionType ManagementPositionType @map("position_type")

  divisionId   String  @map("division_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid

  reservedByAccountRequestId String? @unique @map("reserved_by_account_request_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division   Division    @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  reservedByAccountRequest AccountRequest? @relation("ManagementPositionReservation", fields: [reservedByAccountRequestId], references: [id], onDelete: Restrict)

  assignments     ManagementAssignment[]
  accountRequests AccountRequest[]       @relation("AccountRequestManagementPosition")

  @@index([positionType], map: "management_positions_type_idx")
  @@index([divisionId], map: "management_positions_division_idx")
  @@index([departmentId], map: "management_positions_department_idx")
  @@index([isActive], map: "management_positions_is_active_idx")
  @@map("management_positions")
}

model ManagementAssignment {
  id String @id @default(uuid()) @db.Uuid

  positionId String @map("position_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  assignedByAccountId String  @map("assigned_by_account_id") @db.Uuid
  endedByAccountId    String? @map("ended_by_account_id") @db.Uuid

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  assignmentReason String? @map("assignment_reason") @db.VarChar(500)
  endReason        String? @map("end_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  position ManagementPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  assignedBy Account  @relation("ManagementAssignmentsAssignedBy", fields: [assignedByAccountId], references: [id], onDelete: Restrict)
  endedBy    Account? @relation("ManagementAssignmentsEndedBy", fields: [endedByAccountId], references: [id], onDelete: Restrict)

  @@index([positionId, endedAt], map: "management_assignments_position_ended_idx")
  @@index([employeeId, endedAt], map: "management_assignments_employee_ended_idx")
  @@index([assignedByAccountId], map: "management_assignments_assigned_by_idx")
  @@index([endedByAccountId], map: "management_assignments_ended_by_idx")
  @@index([startedAt], map: "management_assignments_started_at_idx")
  @@map("management_assignments")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activityEvents ActivityEvent[]

  @@index([accountId, revokedAt], map: "auth_sessions_account_revoked_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model OtpVerification {
  id           String     @id @default(uuid()) @db.Uuid
  employeeId   String     @map("employee_id") @db.Uuid
  purpose      OtpPurpose
  otpHash      String     @map("otp_hash") @db.VarChar(255)
  attemptCount Int        @default(0) @map("attempt_count")
  maxAttempts  Int        @default(5) @map("max_attempts")
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, purpose, createdAt], map: "otp_employee_purpose_created_idx")
  @@index([expiresAt], map: "otp_expires_at_idx")
  @@map("otp_verifications")
}

model DepartmentTeam {
  id                  String    @id @default(uuid()) @db.Uuid
  departmentId        String    @map("department_id") @db.Uuid
  name                String    @db.VarChar(120)
  nameKey             String    @map("name_key") @db.VarChar(120)
  teamAdminEmployeeId String    @map("team_admin_employee_id") @db.Uuid
  createdByAccountId  String    @map("created_by_account_id") @db.Uuid
  updatedByAccountId  String    @map("updated_by_account_id") @db.Uuid
  isActive            Boolean   @default(true) @map("is_active")
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)
  archivedByAccountId String?   @map("archived_by_account_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  department       Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
