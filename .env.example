# Local development environment template.
# Copy to .env and replace every placeholder. Never commit .env.

# Application
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Frontend build-time settings for local Vite development when needed.
# The staging Docker build uses same-origin /api/v1 and Socket.IO routing.
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000

# PostgreSQL
POSTGRES_DB=nt_message
POSTGRES_USER=nt_message_app
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nt_message_app:replace_with_secure_password@localhost:5432/nt_message?schema=public

# Valkey (reserved by the project; the current API does not consume VALKEY_URL yet)
VALKEY_PASSWORD=replace_with_secure_password
VALKEY_PORT=6379
VALKEY_URL=redis://:replace_with_secure_password@localhost:6379

# Email
# Local development may use Mailpit. Staging/production must use the approved SMTP relay/provider.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM="NT Message <no-reply@nt-message.local>"
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Authentication / account security
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_refresh_secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_NAME=nt_message_refresh
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_HASH_SECRET=replace_with_long_random_otp_hash_secret
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
ACTIVATION_TOKEN_SECRET=replace_with_long_random_activation_secret
ACTIVATION_TOKEN_TTL_SECONDS=600
ACTIVATION_INVITATION_TTL_HOURS=72

# Initial Super Admin seed. The seed does not overwrite an existing admin password.
SUPER_ADMIN_NAME="replace_with_super_admin_name"
SUPER_ADMIN_EMAIL=replace-with-official-email@ntc.net.np
SUPER_ADMIN_PHONE=98XXXXXXXX
SUPER_ADMIN_INITIAL_PASSWORD=replace_with_at_least_16_characters
INITIAL_ADMIN_USERNAME=admin

# Attachment / profile storage
# Production requires an absolute ATTACHMENT_STORAGE_ROOT.
ATTACHMENT_STORAGE_ROOT=
ATTACHMENT_UPLOAD_TEMP_DIR=
PROFILE_PHOTO_STORAGE_DIR=
GROUP_PHOTO_STORAGE_DIR=
MESSAGE_PRIVATE_ATTACHMENT_RETENTION_DAYS=90
MESSAGE_PERSONAL_GROUP_ATTACHMENT_RETENTION_DAYS=30
MESSAGE_OFFICIAL_GROUP_ATTACHMENT_RETENTION_DAYS=30
ANNOUNCEMENT_ATTACHMENT_RETENTION_DAYS=90

# Attachment malware scanning
# Production requires ATTACHMENT_SCAN_MODE=clamav and a reachable ClamAV daemon.
ATTACHMENT_SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Browser push notifications
# Generate a fresh VAPID pair per environment. Never place a real private key in this template.
WEB_PUSH_VAPID_PUBLIC_KEY=replace_with_public_vapid_key
WEB_PUSH_VAPID_PRIVATE_KEY=replace_with_private_vapid_key
WEB_PUSH_VAPID_SUBJECT=mailto:replace-with-operations-contact@ntc.net.np
WEB_PUSH_TTL_SECONDS=300
