# Application
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Background browser notifications (generate one VAPID key pair and keep the private key secret)
WEB_PUSH_VAPID_PUBLIC_KEY=BHB-UHEjEZ287t-CUvl0904wQBLjwUBVL8B25a-B3BYbXjrlQQix62mmGzkjWrML4ZRNjD2JOfAp029pc6yaUz0
WEB_PUSH_VAPID_PRIVATE_KEY=MBp2EfKd6NEGA4BPpTyTp9AoyN4fwBSIlfeL7HZZWKE
WEB_PUSH_VAPID_SUBJECT=mailto:replace-with-operations-contact@ntc.net.np
WEB_PUSH_TTL_SECONDS=300

# PostgreSQL
POSTGRES_DB=nt_message
POSTGRES_USER=nt_message_app
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://nt_message_app:replace_with_secure_password@localhost:5432/nt_message?schema=public

# Valkey
VALKEY_PASSWORD=replace_with_secure_password
VALKEY_PORT=6379

VALKEY_URL=redis://:replace_with_secure_password@localhost:6379

# Email
# Local development uses Mailpit. Production should point these SMTP_* values
# to the approved Nepal Telecom mail relay/provider instead of Mailpit.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Local Mailpit defaults
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM=NT Message <no-reply@nt-message.local>

# Production SMTP authentication (leave both empty only when the approved relay
# authenticates by server/IP instead of username/password). Never commit secrets.
SMTP_USER=
SMTP_PASSWORD=

# Safe network timeouts
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Typical production examples:
# Port 587 (STARTTLS): SMTP_SECURE=false, SMTP_REQUIRE_TLS=true
# Port 465 (TLS):      SMTP_SECURE=true,  SMTP_REQUIRE_TLS=false

# Initial administrator seed
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_at_least_16_characters

# Authentication
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_refresh_secret

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

AUTH_COOKIE_NAME=nt_message_refresh

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Shared OTP security controls
# Use a long random secret. OTP values are stored only as HMAC hashes.
OTP_HASH_SECRET=replace_with_long_random_otp_hash_secret
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Account activation token
ACTIVATION_TOKEN_SECRET=replace_with_long_random_secret
ACTIVATION_TOKEN_TTL_SECONDS=600

# Secure account invitation link
ACTIVATION_INVITATION_TTL_HOURS=72
