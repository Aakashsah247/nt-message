{
  "name": "nt-message",
  "version": "0.1.0",
  "private": true,
  "description": "Secure internal messaging platform for Nepal Telecom employees",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api start:dev",
    "build": "pnpm --dir apps/web build && pnpm --dir apps/api build",
    "lint": "pnpm --dir apps/web lint && pnpm --dir apps/api lint",
    "test": "pnpm --dir apps/api test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:restart": "docker compose restart",
    "infra:status": "docker compose ps",
    "infra:logs": "docker compose logs -f"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "dependencies": {
    "jsonwebtoken": "9.0.0"
  }
}
